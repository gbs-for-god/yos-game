# 기기 간 상태 공유(참여자 등록, 마니또 미션)용 Upstash Redis.
# Vercel Marketplace 에서 Upstash Redis 를 연결하면 KV_REST_API_URL / KV_REST_API_TOKEN 이 자동 주입된다.
# 비워 두면 서버 메모리에 저장한다 (로컬 개발·E2E 용, 서버 재시작 시 초기화).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 사회자 비밀번호. 비워 두면 lib/members/members.json 의 hostPin 을 쓴다.
HOST_PIN=
